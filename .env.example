# Public site URL — used for canonical URLs, sitemap, Open Graph. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Contact email shown on /اتصل-بنا (left empty → page says it will be published at launch).
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only after cookie consent.
NEXT_PUBLIC_GA_ID=
# Google AdSense publisher ID (ca-pub-XXXXXXXX). Enables ad slots + consent banner.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
